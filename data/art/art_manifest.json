  "canvas_contracts": {
    "travel_presentations": {
      "design_size": [1280, 720],
      "stage_size": [1152, 500],
      "stage_position": [64, 116],
      "placeholder_native_size": [1774, 887],
      "replacement_layer_size": [2048, 1024],
      "source_aspect_ratio": "Main layers 2:1; source width 0.80, view height = source width * actual source aspect * 500 / 1152. Same close crop for all modes.",
      "duration_seconds": 8.0,
      "main_camera_end_uv": 0.18,
      "backdrop_camera_rate": 0.35,
      "exterior_coordinates": "UVs relative to the full PNG; reference_size must match the actual texture dimensions",
      "vehicle_coordinates": "source_px is relative to reference_size; door, panel, hinge and wheel UVs are relative to the tight source_px rectangle",
      "view_bottom_uv": {"walk": 1.0, "vehicle": 1.0},
      "vehicle_ground_policy": "Facade and extended clear arrival ground are painted into one RGBA main image. Wheels and drop-off feet use the measured road_y_uv within that image. No separate material plane or foreground band is rendered.",
      "vehicle_width_base_uv": {"bus": 0.48, "taxi": 0.34, "night_cab": 0.34},
      "actor_depth_scale": "Indoor avatar height is min(0.20 * scene_scale, measured_door_height * 0.82), fixed throughout exit/approach/entry, feet at measured sill. Default outdoor walk-away recedes to 0.58. Delta Queen uses its actual 92x59 boarding clearance: full-size exit, ground-Y approach to about 0.656 and gradual gangway shrink to 0.272717, feet at the authored floor. No scale pop.",
      "gait_and_direction": "Eight-second choreography; base 1.10 cadence with deterministic bounded 6% rate and 0.88-1.0 amplitude variation, continuous phase across beats/turns and frozen phase while stopped. Shared renderer faces back on negative-Y motion and front during horizontal transit/drop-off.",
      "locomotion_blending": "Travel opt-in snapshot: 0.18s smooth start, 0.20s stop followthrough (final outdoor settle finishes at 8s), independent continuous idle clock. Existing painter gesture blend smoothly returns arms to rest; legs and hip blend too. Legacy empty-snapshot avatar drawing and TableVisuals are unchanged.",
      "vehicle_suspension": "At most 1.15 logical pixels versus original 1.5; irregular time-based waves independent of wheel angle/radius and RNG. At the 500px stage, body displacement peaks at 1.315px; roof pixels move bus 1px/taxi 1px/night cab 2px while wheels remain grounded. Stops have no suspension motion.",
      "alpha_compositing": "Preserve exact PNG bytes. travel_scene_cutout.gdshader sets alpha <=2/255 to zero and near-opaque paint >=0.80 to opaque for main/entrance layers, >=0.95 for vehicles. Lower alpha coverage remains transparent.",
      "arrival_progress": "Actual vehicle approach and authored pedestrian path distance; door arrivals reserve the final 2 percent for physical leaf closure. Not elapsed time or loading progress.",
      "layers": "separate opaque far backdrop at 0.35 main-camera speed; continuous-clock RGBA facade plus integrated ground at main speed; optional textured vehicle; back entrance; canonical character with portal clipping or outdoor walk-away; front textured door/frame; shared title/details/receipt/input UI with narration hidden"
    },
