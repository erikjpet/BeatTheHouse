      },
      "map_corner": {
        "text": "Travel spends time and may cost cash; open hours matter. Buy gear, gamble, manage Debt, and earn Bronze toward Gold. Open the map; the corner store is your only stop.",
        "choices": [{"id": "continue", "label": "Open the map", "effects": {}, "end": true}]
      },
      "map_destination": {
        "text": "The map shows travel cost, minutes, and open state. Corner Store costs $0 now. Select it, then Travel.",
        "choices": [{"id": "continue", "label": "Choose corner store", "effects": {}, "end": true}]
      },
      "corner_items": {
        "text": "Inspect both shelf items. Each card shows price and what your Bankroll will be after purchase. Buy either one.",
        "choices": [{"id": "continue", "label": "Check the shelf", "effects": {}, "end": true}]
      },
      "crew_warning": {
        "text": "That Crew cash isn't free. Take it, and sooner or later they'll put you to work for it.",
        "choices": [{"id": "continue", "label": "Good to know", "effects": {}, "end": true}]
      },
      "family_phone": {
        "text": "Use the counter phone and take the $30 family loan. It raises Bankroll now, adds family Debt to the HUD, and future cashout pays Debt first.",
        "choices": [{"id": "continue", "label": "Use the phone", "effects": {}, "end": true}]
      },
      "family_debt": {
        "text": "The receipt icon is family Debt. Bankroll rose by $30, but cashout pays Debt first. Keep enough cash to survive the run.",
        "choices": [{"id": "continue", "label": "Debt understood", "effects": {}, "end": true}]
      },
      "parking_tip": {
        "text": "Open the parking-lot note and choose Follow the tip. It may lead somewhere useful later.",
        "choices": [{"id": "continue", "label": "Follow the lead", "effects": {}, "end": true}]
      },
      "route_split": {
        "text": "That tip opened two doors. I strongly recommend the Gas Casino lesson, but it is optional: choose Gas Casino, or skip it and go straight Underground.",
        "choices": [{"id": "continue", "label": "Choose a route", "effects": {}, "end": true}]
      },
      "gas_machine": {
        "text": "Open the pull-tab machine. Outcomes are fixed when each ticket is bought; peeling only reveals them. Your glasses mark a real winner in the stack.",
        "choices": [{"id": "continue", "label": "Open the machine", "effects": {}, "end": true}]
      },
      "gas_xray": {
        "text": "Read the yellow marker: it shows tickets left and total cost. Buy that column, then Collect each dropped ticket until the marked winner is purchased.",
        "choices": [{"id": "continue", "label": "Buy and collect", "effects": {}, "end": true}]
      },
      "gas_peel": {
        "text": "Select the marked ticket, Peel all three windows, then File it into the winner pile. Piles shows sorted tickets; Leave only after the winner is filed.",
        "choices": [{"id": "continue", "label": "Collect and peel", "effects": {}, "end": true}]
      },
      "gas_clerk": {
        "text": "Leave the machine, open Rina's clerk tray, and Redeem. A filed winner is not cash until the clerk pays it.",
        "choices": [{"id": "continue", "label": "Cash the winner", "effects": {}, "end": true}]
      },
      "gas_depart": {
        "text": "Open the map and head underground. The gas stop was optional.",
        "choices": [{"id": "continue", "label": "Go underground", "effects": {}, "end": true}]
      },
      "underground_enter": {
        "text": "At blackjack, get closer to 21 than the dealer without going over. 2-10 use their number, face cards are 10, and an Ace is 1 or 11. Sit for a clean hand.",
        "choices": [{"id": "continue", "label": "Take a seat", "effects": {}, "end": true}]
      },
      "blackjack_normal": {
        "text": "Choose the wager with the felt chips; Deal locks it. Hit takes a card. Stand keeps your total for dealer comparison. Deal this deterministic practice hand.",
        "choices": [{"id": "continue", "label": "Deal clean", "effects": {}, "end": true}]
      },
      "blackjack_finish": {
        "text": "Your total is ready. Stand; the dealer then draws by house rules and compares totals. Going over 21 would bust immediately.",
        "choices": [{"id": "continue", "label": "Stand", "effects": {}, "end": true}]
      },
      "blackjack_raise": {
        "text": "Use the felt chips to raise your bet before DEAL locks it in.",
        "choices": [{"id": "continue", "label": "Raise the bet", "effects": {}, "end": true}]
      },
      "blackjack_deal_raised": {
        "text": "Deal locks the raised wager. Risky actions spend their named prop or opportunity, reveal useful information, and can add Heat if mistimed.",
        "choices": [{"id": "continue", "label": "Deal", "effects": {}, "end": true}]
      },
      "heat_before_cheat": {
        "text": "Before cheating, read Heat at the top. Full Heat ends the run. A caught Peek or missed count bubble adds Heat; clean play, leaving, or cooling off avoids more attention.",
        "choices": [{"id": "continue", "label": "I understand Heat", "effects": {}, "end": true}]
      },
      "blackjack_lookaway": {
        "text": "The easiest cheat is the real lookaway: DRINK PASS spills a drink; CHIP SPILL is the backup opening. A caught Peek adds Heat. Travel or clean play can cool attention.",
        "choices": [{"id": "continue", "label": "Create a lookaway", "effects": {}, "end": true}]
      },
      "blackjack_peek": {
        "text": "PEEK only while the attention window is open; it reveals the dealer hole card for Hit or Stand. Getting caught will add heat and can close the table.",
        "choices": [{"id": "continue", "label": "Peek now", "effects": {}, "end": true}]
      },
      "blackjack_count_start": {
        "text": "COUNT uses Hi-Lo: 2-6 = +1, 7-9 = 0, 10-Ace = -1. Start it; every visible card creates one bubble.",
        "choices": [{"id": "continue", "label": "Start counting", "effects": {}, "end": true}]
      },
      "blackjack_count_bubbles": {
        "text": "Select every bubble before it fades. A positive running count means more 10s and Aces may remain. A miss adds Heat; perfect counting avoids that penalty.",
        "choices": [{"id": "continue", "label": "Clear every bubble", "effects": {}, "end": true}]
      },
      "heat": {
        "text": "That real mistake raised Heat. Full Heat ends the run and high Heat makes risky play harsher. Stop cheating, play clean, or travel to cool off before trying again.",
        "choices": [{"id": "continue", "label": "Watch the heat", "effects": {}, "end": true}]
      },
      "invitation": {
        "text": "Before you leave, keep an eye on your environment. Open the Grand Casino invitation and accept it.",
        "choices": [{"id": "continue", "label": "Take the invitation", "effects": {}, "end": true}]
      },
      "grand_depart": {
        "text": "I'm banned from the Grand. Play clean around Rourke. Good luck.",
        "choices": [{"id": "continue", "label": "Head to the Grand", "effects": {}, "end": true}]
      }
    }
  },
