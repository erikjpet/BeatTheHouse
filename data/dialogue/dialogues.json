        "choices": [{"id": "continue", "label": "Check inventory", "effects": {}, "end": true}]
      },
      "map_corner": {
        "text": "Time to move. Open the travel map. Tonight starts with one honest light: the corner store.",
        "choices": [{"id": "continue", "label": "Open the map", "effects": {}, "end": true}]
      },
      "corner_items": {
        "text": "Look over every item before you spend. Read the shelf, compare the hooks, then buy the one you want.",
        "choices": [{"id": "continue", "label": "Check the shelf", "effects": {}, "end": true}]
      },
      "crew_warning": {
        "text": "See the Crew in the corner? They are the last place you turn. Their cash is quick because the favor comes due slow.",
        "choices": [{"id": "continue", "label": "Keep my distance", "effects": {}, "end": true}]
      },
      "family_phone": {
        "text": "The counter phone is safer, not free. Make the family call and take the loan. Watch the debt follow you onto the HUD.",
        "choices": [{"id": "continue", "label": "Use the phone", "effects": {}, "end": true}]
      },
      "parking_tip": {
        "text": "That note in the lot is an event. Open it and choose Follow the tip. It may lead somewhere useful later.",
        "choices": [{"id": "continue", "label": "Follow the lead", "effects": {}, "end": true}]
      },
      "route_split": {
        "text": "The tip opened two doors. I strongly recommend the gas-station casino first; your glasses can earn travel money there. You may skip it and go underground now.",
        "choices": [{"id": "continue", "label": "Choose a route", "effects": {}, "end": true}]
      },
      "gas_machine": {
        "text": "There is the pull-tab machine. Get close. Your glasses can read what the paper is trying to hide.",
        "choices": [{"id": "continue", "label": "Open the machine", "effects": {}, "end": true}]
      },
      "gas_xray": {
        "text": "The X-ray mark points to a real winner tucked near the bottom of a stack. Buy down to that marked tab — the result is already fixed.",
        "choices": [{"id": "continue", "label": "Buy the marked tab", "effects": {}, "end": true}]
      },
      "gas_peel": {
        "text": "Now peel every window. The glasses found the edge; the tab still has to be played before it can be paid.",
        "choices": [{"id": "continue", "label": "Peel the tab", "effects": {}, "end": true}]
      },
      "gas_clerk": {
        "text": "Winner in hand. Leave the machine and take the good paper to Rina at the clerk tray. Machines sell; clerks settle.",
        "choices": [{"id": "continue", "label": "Cash the winner", "effects": {}, "end": true}]
      },
      "gas_depart": {
        "text": "Clean cash, useful lesson. Open the map and head underground. That part was optional; the next table is not.",
        "choices": [{"id": "continue", "label": "Go underground", "effects": {}, "end": true}]
      },
      "underground_enter": {
        "text": "Blackjack first. Sit at the table and play one ordinary hand before we bend anything.",
        "choices": [{"id": "continue", "label": "Take a seat", "effects": {}, "end": true}]
      },
      "blackjack_normal": {
        "text": "Start clean. Put out the current bet and deal. Read the cards, then finish the hand normally.",
        "choices": [{"id": "continue", "label": "Deal clean", "effects": {}, "end": true}]
      },
      "blackjack_finish": {
        "text": "Stand this one out. A normal hand teaches you what the table looks like before heat gets in the way.",
        "choices": [{"id": "continue", "label": "Stand", "effects": {}, "end": true}]
      },
      "blackjack_raise": {
        "text": "Use the on-felt chips to raise the bet. Bigger chips change the next hand's risk before DEAL locks it in.",
        "choices": [{"id": "continue", "label": "Raise the bet", "effects": {}, "end": true}]
      },
      "blackjack_deal_raised": {
        "text": "The raised wager is showing. Deal the next hand and keep your eyes on the dealer's attention strip.",
        "choices": [{"id": "continue", "label": "Deal", "effects": {}, "end": true}]
      },
      "blackjack_lookaway": {
        "text": "The easiest cheat here starts with a distraction. DRINK PASS spills a drink; CHIP SPILL works too. Either opens a short lookaway — trigger one, then move fast.",
        "choices": [{"id": "continue", "label": "Create a lookaway", "effects": {}, "end": true}]
      },
      "blackjack_peek": {
        "text": "PEEK only while the attention strip says the window is open. Outside it, the dealer can catch you, add heat, and close the table.",
        "choices": [{"id": "continue", "label": "Peek now", "effects": {}, "end": true}]
      },
      "blackjack_count_start": {
        "text": "Counting is the other edge. Start COUNT and the visible cards will throw count bubbles onto the felt.",
        "choices": [{"id": "continue", "label": "Start counting", "effects": {}, "end": true}]
      },
      "blackjack_count_bubbles": {
        "text": "Hit every count bubble before it fades. Miss one and you trip over the count — the table adds heat.",
        "choices": [{"id": "continue", "label": "Clear every bubble", "effects": {}, "end": true}]
      },
      "heat": {
        "text": "That is heat. Keep it away from the top; fill the meter and the police arrive — or someone worse gets there first.",
        "choices": [{"id": "continue", "label": "Watch the heat", "effects": {}, "end": true}]
      },
      "invitation": {
        "text": "Always keep an eye on your environment. Look at that Grand Casino invitation, open it, and accept it before you leave.",
        "choices": [{"id": "continue", "label": "Take the invitation", "effects": {}, "end": true}]
      },
      "grand_depart": {
        "text": "The Grand is open. I am banned there — long story — so your pal stops here. Play clean around Rourke; he notices systems. Good luck.",
        "choices": [{"id": "continue", "label": "Head to the Grand", "effects": {}, "end": true}]
      }
    }
  },
