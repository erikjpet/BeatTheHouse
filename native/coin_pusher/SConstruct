#!/usr/bin/env python

import os

godot_cpp_dir = ARGUMENTS.get("godot_cpp_dir", "")
if not godot_cpp_dir or not os.path.isfile(os.path.join(godot_cpp_dir, "SConstruct")):
    raise RuntimeError("godot_cpp_dir must identify the pinned godot-cpp checkout")
del ARGUMENTS["godot_cpp_dir"]
output_path = ARGUMENTS.get("output_path", "../../addons/coin_pusher_native/bin/coin_pusher_native_v3_10")
if "output_path" in ARGUMENTS:
    del ARGUMENTS["output_path"]

# This extension only derives from RefCounted. Keep the generated Godot binding
# surface to that ancestry (plus godot-cpp's mandatory runtime classes) so Web
# does not have to compile and link wrappers for unrelated engine features.
ARGUMENTS["build_profile"] = os.path.join(Dir("#").abspath, "build_profile.json")

env = SConscript(os.path.join(godot_cpp_dir, "SConstruct"))
env.Append(CPPPATH=["src"])
env.Append(CXXFLAGS=["-std=c++17"])
if env["platform"] == "web":
    # The pinned release engine is built with wasm_simd=yes. Match that feature
    # set for the numeric side-module so Clang can vectorize the fixed-width
    # integer scans without changing solver order or the public ABI.
    env.Append(CCFLAGS=["-msimd128"])

sources = Glob("src/*.cpp")
library = env.SharedLibrary(
    "{}{}{}".format(output_path, env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
env.NoCache(library)
Default(library)
