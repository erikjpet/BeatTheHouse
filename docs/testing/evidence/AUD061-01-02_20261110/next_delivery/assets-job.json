    "from pathlib import Path\nimport json,urllib.request,hashlib,datetime,os\nsha='18af19ac2878855e18588b8a618ff58cb2002290';tree='c6b18e300ac15dc6f3b443c827a1879b09cf243a';base='http://localhost:8088/p/beat-the-house/play/'\nstatus=json.loads(Path(r'D:\\Projects\\site\\state\\bth-next\\status.json').read_text(encoding='utf-8-sig'));stage=json.loads(Path(status['mirror_stage']['stage']).read_text(encoding='utf-8-sig'))\nassert stage['source_commit']==sha and stage['source_tree']==tree\nresult={'checked_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'expected_commit':sha,'expected_tree':tree,'archive_sha256':stage['archive']['sha256'],'watcher_phase':status['phase'],'deployed_at':status['deployed_at'],'files':[]}\nwith urllib.request.urlopen(base+'next.json',timeout=20) as r:next_data=json.load(r)\nassert next_data['source_commit']==sha and next_data['source_tree']==tree and next_data['archive_sha256']==stage['archive']['sha256'];result['next']=next_data\nwith urllib.request.urlopen(base+'dev/',timeout=20) as r:result['entry_final_url']=r.geturl();result['entry_status']=r.status\nfor x in stage['files']:\n name=x['path']\n if name not in ['BUILD.json','build_manifest.json','REF','VERSION','index.html','index.js','index.pck','index.wasm','index.side.wasm'] and not name.startswith('coin_pusher_native'):continue\n method='HEAD' if name in ['index.wasm','index.side.wasm'] else 'GET'\n with urllib.request.urlopen(urllib.request.Request(base+'dev/'+sha+'/'+name,method=method),timeout=30) as r:\n  facts={'path':name,'method':method,'status':r.status,'mime':r.headers.get_content_type(),'expected_sha256':x['sha256'],'expected_bytes':x['bytes']}\n  if method=='HEAD':\n   facts['bytes']=int(r.headers.get('Content-Length','-1'));facts['sha256_scope']='Unchanged engine pin reused from exact stage and next web_gl_handles; served status/MIME/length checked.'\n   assert facts['bytes']==x['bytes'] and facts['mime']=='application/wasm'\n   assert next_data['web_gl_handles']['engine_assets'][name]==x['sha256']\n  else:\n   h=hashlib.sha256();size=0;small=b''\n   while True:\n    chunk=r.read(65536)\n    if not chunk:break\n    h.update(chunk);size+=len(chunk)\n    if size<4096:small+=chunk\n   facts.update(bytes=size,sha256=h.hexdigest(),matches=h.hexdigest()==x['sha256'] and size==x['bytes']);assert facts['matches'],name\n   if name in ['BUILD.json','build_manifest.json']:\n    facts['metadata']=json.loads(small);assert facts['metadata']['source_commit']==sha and facts['metadata']['source_tree']==tree\n   if name=='REF':assert small.decode().strip()==sha\n  result['files'].append(facts)\nresult['result']='PASS';out=Path(os.environ['BTH_QA_EVIDENCE_DIR'])/'served-assets.json';out.write_text(json.dumps(result,indent=2)+'\\n',encoding='utf-8');print(json.dumps(result,indent=2))"
