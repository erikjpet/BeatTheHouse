n_pusher_export_parity.scn\", binary) == OK, \"PCK scene add %d\" % index)\n+\\t\\tcheck(pack.flush() == OK, \"PCK flush %d\" % index)\n+\\t\\tfacts.append({\"iteration\":index,\"binary_bytes\":FileAccess.get_file_as_bytes(binary).size(),\"package_bytes\":FileAccess.get_file_as_bytes(package).size()})\n+\\tprint(JSON.stringify({\"checks\":checks,\"failure_count\":failures.size(),\"failures\":failures,\"facts\":facts,\"scope\":\"Resource load with actual dependencies, binary serialize and single-resource PCK flush; not EditorExportPlugin dependency transformation or a launchable Web export.\"}))\n+\\tquit(0 if failures.is_empty() else 1)\n+'''.replace('\\n+','\\n'))\n"
