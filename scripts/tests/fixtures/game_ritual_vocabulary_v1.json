  "game_facts": [
    {
      "id": "session.started",
      "version": 1,
      "boundary": "action",
      "visibility": "public",
      "payload": {
        "session_id": "string"
      }
    },
    {
      "id": "commitment.accepted",
      "version": 1,
      "boundary": "action",
      "visibility": "public",
      "payload": {
        "commitment_id": "string",
        "at_risk_total": "int"
      }
    },
    {
      "id": "resolution.completed",
      "version": 1,
      "boundary": "action",
      "visibility": "public",
      "payload": {
        "result_id": "string",
        "net_change": "int"
      }
    },
    {
      "id": "session.ended",
      "version": 1,
      "boundary": "action",
      "visibility": "public",
      "payload": {
        "session_id": "string"
      }
    }
