{
  "contract": "game_ritual/1",
  "ritual_id": "example_table.standard_session",
  "initial_phase": "open",
  "ritual_phases": [
    {
      "id": "open",
      "entry_conditions": [],
      "permitted_actions": [
        "commit.place",
        "commit.correct",
        "commit.remove",
        "commit.undo",
        "commit.clear",
        "commit.repeat",
        "commit.rebet",
        "commit.confirm"
      ],
      "entry_operations": [],
      "transitions": [
        {
          "id": "open_to_committed",
          "condition": {
            "kind": "accepted_action",
            "action_id": "commit.confirm"
          },
          "next_phase": "committed",
          "operations": [
            {
              "family": "actor",
              "verb": "set_pose",
              "target": "staff.primary",
              "state": "offer"
            }
          ]
        }
      ],
      "terminal": false
    },
    {
      "id": "committed",
      "entry_conditions": [
        {
          "kind": "receipt_present",
          "receipt_kind": "commitment"
        }
      ],
      "permitted_actions": [
        "play.primary"
      ],
      "entry_operations": [],
      "transitions": [
        {
          "id": "committed_to_resolving",
          "condition": {
            "kind": "accepted_action",
            "action_id": "play.primary"
          },
          "next_phase": "resolving",
          "operations": [
            {
              "family": "object",
              "verb": "set_visual_state",
              "target": "apparatus.primary",
              "state": "active"
            }
          ]
        }
      ],
      "terminal": false
    },
    {
      "id": "resolving",
      "entry_conditions": [
        {
          "kind": "authoritative_result_present"
        }
      ],
      "permitted_actions": [
        "resolution.acknowledge"
      ],
      "entry_operations": [
        {
          "family": "actor",
          "verb": "set_behavior",
          "target": "staff.primary",
          "state": "reacting"
        }
      ],
      "transitions": [
        {
          "id": "resolving_to_open",
          "condition": {
            "kind": "accepted_action",
            "action_id": "resolution.acknowledge"
          },
          "next_phase": "open",
          "operations": [
            {
              "family": "object",
              "verb": "set_visual_state",
              "target": "apparatus.primary",
              "state": "idle"
            }
          ]
        }
      ],
      "terminal": false
    }
  ],
  "staged_commitment": {
    "pending_collection": "pending_items",
    "working_collection": "working_items",
    "resolution_collection": "item_resolutions",
    "funds_authority": "game_rules",
    "actions": [
      {
        "id": "commit.place",
        "effect": "add_or_increment_one"
      },
      {
        "id": "commit.correct",
        "effect": "replace_one_pending_amount"
      },
      {
        "id": "commit.remove",
        "effect": "remove_one_pending_item"
      },
      {
        "id": "commit.undo",
        "effect": "reverse_last_pending_edit"
      },
      {
        "id": "commit.clear",
        "effect": "remove_all_pending_items"
      },
      {
        "id": "commit.repeat",
        "effect": "copy_last_eligible_commitment"
      },
      {
        "id": "commit.rebet",
        "effect": "copy_eligible_resolved_items"
      },
      {
        "id": "commit.confirm",
        "effect": "authorize_pending_set"
      }
    ],
    "readable_totals": [
      "available_funds",
      "pending_total",
      "at_risk_total",
      "returned_stake",
      "payout",
      "net_change"
    ]
  },
  "pointer_verbs": [
