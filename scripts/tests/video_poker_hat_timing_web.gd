extends Node

# BTH-PERF-20261104-002 attribution probe. No saves, settings or player profile
# are read/written. The cabinet is generated by the production module and Deal
# supplies the normal UI-local hold state; cards are not injected. Direct helper
# timings are synthetic attribution, not normal rendered gameplay proof.
# Export this test-only scene as main through the current resource owner.

const ContentLibraryScript := preload("res://scripts/core/content_library.gd")
const RunStateScript := preload("res://scripts/core/run_state.gd")
const VideoPokerScript := preload("res://scripts/games/video_poker.gd")
const DEFAULT_SAMPLES := 3
const WARM_REPEATS := 8

var failures: Array[String] = []


func _ready() -> void:
	if OS.has_feature("web"):
		JavaScriptBridge.eval("window.__bth_vp_hat_timing_ready = true; window.__bth_vp_hat_timing_done = false; window.__bth_vp_hat_timing_report = null;", true)
	call_deferred("_run")


func _run() -> void:
	var library: ContentLibrary = ContentLibraryScript.new()
	library.load(false)
	if library.game("video_poker").is_empty() or library.item("freds_poker_hat").is_empty() or not library.validation_errors.is_empty():
		failures.append("Required production content did not load: %s" % str(library.validation_errors))
	var rows: Array = []
	var configured_samples := OS.get_environment("BTH_VP_HAT_SAMPLES")
	var sample_count := clampi(int(configured_samples), 1, 6) if configured_samples.is_valid_int() else DEFAULT_SAMPLES
	if failures.is_empty():
		for sample_index in range(sample_count):
			rows.append(_measure_generated_hand(library, sample_index))
	var report := {
		"finding_id": "BTH-PERF-20261104-002",
		"method": "generated cabinet + production Deal command; direct cold/warm strategy helper",
		"fidelity": "synthetic Web attribution; generated hands, no normal rendered player action",
		"source_sha_reported_by_runner": OS.get_environment("BTH_PERF_SOURCE_SHA"),
		"engine": Engine.get_version_info(),
		"platform": OS.get_name(),
		"web_feature": OS.has_feature("web"),
		"sample_count_requested": sample_count,
		"warm_repeats_per_hand": WARM_REPEATS,
		"rows": rows,
		"functional_checks_passed": failures.is_empty() and rows.size() == sample_count,
		"performance_budget_verdict": "none; attribution measurements only",
		"failures": failures,
	}
	print("BTH_VP_HAT_TIMING_REPORT " + JSON.stringify(report))
	_publish(report)


func _measure_generated_hand(library: ContentLibrary, sample_index: int) -> Dictionary:
	var seed_text := "BTH-PERF-20261104-002-%d" % sample_index
	var run: RunState = RunStateScript.new()
	run.start_new(seed_text)
	run.bankroll = 10000
	var game: GameModule = VideoPokerScript.new()
	game.setup(library.game("video_poker"), library)
	var environment := {"id": "vp_hat_timing", "archetype_id": "bar", "kind": "casino", "game_ids": ["video_poker"], "game_states": {}}
	var generated: Dictionary = game.generate_environment_state(run, environment, run.create_rng("vp_hat_timing_machine"))
	environment["game_states"] = {"video_poker": generated}
	run.set_environment(environment)
	environment = run.current_environment
	game.enter(run, environment)
	var deal: Dictionary = game.surface_action_command("video_poker_deal", 0, false, {}, run, environment)
	var ui: Dictionary = deal.get("ui_state", {})
	var bare_started := Time.get_ticks_usec()
	var bare: Dictionary = game.surface_state(run, environment, ui)
	var bare_surface_usec := Time.get_ticks_usec() - bare_started
	var hand: Array = bare.get("hand", [])
	if not bool(deal.get("handled", false)) or str(bare.get("phase", "")) != "hold" or hand.size() != VideoPokerScript.HAND_SIZE or bool(bare.get("poker_hat_strategy_active", false)):
		failures.append("Sample %d did not reach an ordinary unassisted generated hold state." % sample_index)
		return {"seed": seed_text, "setup_failed": true}
	run.add_item("freds_poker_hat")
	var machine: Dictionary = game.call("_machine_state", run, environment)
	var variant: Dictionary = game.call("_variant", machine)
	var coin_count := int(bare.get("coin_count", 1))
	var coin_value := int(bare.get("coin_value", 1))
	var is_max_bet := int(ui.get("bet_level", 0)) >= VideoPokerScript.MAX_BET_LEVEL
	var cache: Dictionary = game.get("_strategy_hold_cache")
	if not cache.is_empty():
		failures.append("Sample %d strategy cache was not cold before timing." % sample_index)
		return {"seed": seed_text, "setup_failed": true}
	var before_run := JSON.stringify(run.to_save_snapshot())
	var before_hand := JSON.stringify(hand)
	var cold_started := Time.get_ticks_usec()
	var cold: Array = game.call("_best_odds_holds", hand, variant, machine, coin_count, coin_value, is_max_bet)
	var cold_usec := Time.get_ticks_usec() - cold_started
	var warm_usec: Array[int] = []
	for _repeat in range(WARM_REPEATS):
		var warm_started := Time.get_ticks_usec()
		var warm: Array = game.call("_best_odds_holds", hand, variant, machine, coin_count, coin_value, is_max_bet)
		warm_usec.append(Time.get_ticks_usec() - warm_started)
		if warm != cold:
			failures.append("Sample %d cold/warm recommendations differ." % sample_index)
	var hat_surface_started := Time.get_ticks_usec()
	var hat_surface: Dictionary = game.surface_state(run, environment, ui)
	var warm_hat_surface_usec := Time.get_ticks_usec() - hat_surface_started
	if not bool(hat_surface.get("poker_hat_strategy_active", false)) or hat_surface.get("recommended_holds", []) != cold:
		failures.append("Sample %d equipped hat did not publish the same recommendation." % sample_index)
	if JSON.stringify(run.to_save_snapshot()) != before_run or JSON.stringify(hand) != before_hand:
		failures.append("Sample %d strategy projection mutated the run or source hand." % sample_index)
	if cache.size() != 1:
		failures.append("Sample %d expected exactly one cached dealt-hand recommendation, got %d." % [sample_index, cache.size()])
	return {
		"seed": seed_text,
		"cabinet_id": generated.get("cabinet_id", ""),
		"variant_id": generated.get("variant_id", ""),
		"paytable_tier_id": generated.get("paytable_tier_id", ""),
		"hand": hand,
		"coin_count": coin_count,
		"coin_value": coin_value,
		"is_max_bet": is_max_bet,
		"cold_strategy_usec": cold_usec,
		"warm_strategy_usec": warm_usec,
		"bare_surface_usec": bare_surface_usec,
		"warm_hat_surface_usec": warm_hat_surface_usec,
		"recommended_holds": cold,
		"cache_entries_after": cache.size(),
	}

func _publish(report: Dictionary) -> void:
	set_meta("timing_report", report)
	if OS.has_feature("web"):
		var encoded := JSON.stringify(JSON.stringify(report))
		JavaScriptBridge.eval("window.__bth_vp_hat_timing_report = JSON.parse(%s); window.__bth_vp_hat_timing_done = true;" % encoded, true)
	# Keep the exported scene alive so the browser runner can retrieve the report.
	set_process(false)
